{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pt/projects/:id", "destination": "/pt/index.html" },
    { "source": "/en/projects/:id", "destination": "/en/index.html" }
  ]
}
